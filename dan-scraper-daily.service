[Unit]
Description=Dan Scraper Daily Process
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/dan_scraper
Environment=PYTHONPATH=/root/dan_scraper
ExecStart=/usr/bin/python3 /root/dan_scraper/daily_process.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target