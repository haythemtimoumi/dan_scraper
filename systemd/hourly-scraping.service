[Unit]
Description=Hourly Scraping Service
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/dan_scraper
Environment=PYTHONPATH=/root/dan_scraper
ExecStart=/usr/bin/python3 /root/dan_scraper/hourly_scraping.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target